{
  "name": "n8n-hosting-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "worker": "node --env-file=.env --import tsx lib/queue/workers/index.ts",
    "dev": "concurrently \"next dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration:run": "vitest run --config vitest.config.integration.ts",
    "test:integration": "npm run test:integration:up && npm run test:integration:run; EXIT=$?; npm run test:integration:down; exit $EXIT",
    "test:all": "npm run test && npm run test:integration",
    "dev:local": "USE_LOCAL_DOCKER=true concurrently \"next dev\" \"npm run worker\"",
    "docker:list": "docker ps --filter 'name=n8n-' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'",
    "docker:cleanup": "docker ps -a --filter 'name=n8n-' -q | xargs -r docker rm -f && docker volume ls --filter 'name=n8n-' -q | xargs -r docker volume rm"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@aws-sdk/client-cloudformation": "^3.1000.0",
    "@aws-sdk/client-dynamodb": "^3.896.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/stripe-js": "^7.9.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "ioredis": "^5.8.0",
    "lucide-react": "^0.544.0",
    "mongodb": "^6.20.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.11",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "openai": "^6.3.0",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.12",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
